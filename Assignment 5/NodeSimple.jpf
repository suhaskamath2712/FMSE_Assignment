classpath=${config_path}
sourcepath=${config_path}

target = NodeSimple
symbolic.method = NodeSimple.hasCycleBounded(sym#con)
symbolic.debug = true
listener= gov.nasa.jpf.symbc.SymbolicListener
# listener
listener+= ,gov.nasa.jpf.listener.ExecTracker

# Important configuration
symbolic.lazy = true

# In the presence of Inheritance set this to true
#symbolic.lazy.subtypes = true

et.print_src=true
et.print_insn=false
et.print_mth=true

vm.storage.class=nil