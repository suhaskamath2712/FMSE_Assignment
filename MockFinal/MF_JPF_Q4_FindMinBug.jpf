classpath=${config_path}
sourcepath=${config_path}

target = MockFinal.MF_JPF_Q4_FindMinBug
symbolic.method = MockFinal.MF_JPF_Q4_FindMinBug.findMinBug(con)
symbolic.debug = true
listener= gov.nasa.jpf.symbc.SymbolicListener
listener+= ,gov.nasa.jpf.listener.ExecTracker

# Pretty printing
et.print_src=true
et.print_insn=false
et.print_mth=true

vm.storage.class=nil

# Helpful when exploring failing asserts
search.multiple_errors=true

# Keep the domain small to avoid state explosion
symbolic.min_int = -10
symbolic.max_int = 10
